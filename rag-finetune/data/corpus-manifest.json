{
  "version": 1,
  "description": "Phase 1 training corpus: public documents grouped into libraries that mimic one user's uploads to the RAG knowledge base. Fetched by scripts/fetch_corpus.py into data/raw/<library>/ (gitignored). Every entry carries its license; the dataset built from this corpus is released under CC BY-SA 4.0 because Wikipedia text is included.",
  "selection_criteria": [
    "Text that extracts cleanly with the app's own parser (pdf-parse for PDF, plain text or markdown otherwise): no scanned images, no HTML.",
    "Dense, factual, quotable content: numbers, names, procedures, definitions. Questions with one correct short answer are easy to generate and to grade.",
    "The kind of document a person actually uploads to a knowledge base: guides, handbooks, standards, circulars, reference docs, articles.",
    "Moderate length (roughly 5 to 80 pages) so a library of 4 to 8 documents yields real hard negatives: same topic, different facts.",
    "Topic diversity across libraries so the model does not learn one domain's vocabulary.",
    "License that allows redistribution of verbatim excerpts: US government works (public domain), CC BY / CC BY-SA, MIT, Apache-2.0, BSD, PSF."
  ],
  "libraries": {
    "tax-help": "IRS publications a household would keep together",
    "security-standards": "NIST guidance a security team would store",
    "copyright-office": "US Copyright Office circulars",
    "social-security": "SSA benefit booklets",
    "workplace-safety": "OSHA guides for a safety manager",
    "money-and-home": "Consumer finance guides from CFPB and partners",
    "health-guides": "Federal nutrition, activity and heart-health guides",
    "home-hazards": "EPA and FEMA household safety guides",
    "immigration-civics": "USCIS naturalization materials",
    "python-tutorial": "CPython official tutorial chapters (reStructuredText)",
    "rust-book": "The Rust Programming Language, selected chapters (markdown)",
    "django-docs": "Django documentation, tutorial and topic guides (reStructuredText as text)",
    "wikipedia-history": "Wikipedia articles, history and exploration",
    "wikipedia-science": "Wikipedia articles, natural science",
    "wikipedia-technology": "Wikipedia articles, technology and computing",
    "classic-books": "Short public-domain books from Project Gutenberg"
  },
