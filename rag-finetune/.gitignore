# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Secrets (HF_TOKEN, WANDB_API_KEY, OPENAI_API_KEY)
.env
.env.*
!.env.example

# Experiment tracking and training output
wandb/
outputs/
checkpoints/
*.safetensors
*.bin
*.gguf
*.pt

# Data: raw sources and generated sets live on the HF Hub, not in git.
# The manifest (data/corpus-manifest.json) IS tracked: it is the recipe.
data/raw/
data/generated/
*.jsonl
!tests/fixtures/*.jsonl
# Evaluation results are tracked on purpose: they are the project's record.
!results/**/*.jsonl

# Editable install metadata and local logs
*.egg-info/
*.log
