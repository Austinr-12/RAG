# Copy to .env and fill in real values. Never commit .env.
# Rotation instructions for every secret: see CREDENTIALS.md.

# --- Supabase Postgres (with pgvector) ------------------------------------
# Session pooler URL (port 6543, pgbouncer) for the app; direct URL (5432)
# for migrations. Both carry the same DB password — rotate together.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- OpenAI ---------------------------------------------------------------
# Used for embeddings always, and for chat unless CHAT_BASE_URL is set below.
# Do NOT set OPENAI_BASE_URL to point chat at another server: the embeddings
# client reads that variable too, so retrieval would break.
OPENAI_API_KEY="sk-proj-..."

# --- Chat model override (optional) ---------------------------------------
# Leave these unset to answer with OpenAI gpt-4o-mini. Set CHAT_BASE_URL to
# answer with any OpenAI-compatible Chat Completions server instead (vLLM,
# etc.); comment it out again to switch back. See src/lib/rag/model.ts.
# The URL must include the /v1 suffix. CHAT_MODEL_ID is required with it and
# must match the name the server serves (vLLM: --served-model-name).
# CHAT_BASE_URL="http://localhost:8000/v1"
# CHAT_MODEL_ID="rag-grounded"
# CHAT_API_KEY="..."   # only if the server enforces one (vLLM: --api-key)
# Tighter chat-history budget for small-context models. Rule of thumb for an
# 8k-token window: 16000. Can only lower the built-in 64000 cap.
# CHAT_MAX_HISTORY_CHARS=16000

# --- Clerk auth -----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Rate limiting (optional) ---------------------------------------------
# When both are set, rate limiting switches from per-process memory to
# Upstash Redis (needed for multi-instance deploys). See src/lib/security/rateLimit.ts.
# UPSTASH_REDIS_REST_URL="https://<db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
