#!/usr/bin/env bash
# Refuse a commit whose staged content looks like it contains a credential.
#
# Activated per clone with:   git config core.hooksPath .githooks
# Bypass for a deliberate false positive:   git commit --no-verify
#
# Why: on 2026-10-12 a result JSON carrying the OpenAI key reached a local
# commit and GitHub push protection rejected the push. This catches it one
# step earlier, before the key is in any commit at all.
set -uo pipefail

patterns=(
  'sk-[A-Za-z0-9_-]{20,}'                 # OpenAI keys (sk-, sk-proj-)
  'hf_[A-Za-z0-9]{20,}'                   # Hugging Face tokens
  'AKIA[0-9A-Z]{16}'                      # AWS access keys
  'ghp_[A-Za-z0-9]{30,}'                  # GitHub personal tokens
  'postgres(ql)?://[^:/]+:[^@/]{6,}@'     # database URLs with a password
  '(WANDB_API_KEY|OPENAI_API_KEY|HF_TOKEN|CLERK_SECRET_KEY)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_-]{16,}'
)
regex=$(IFS='|'; echo "${patterns[*]}")

found=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  case "$file" in *.env.example|*/.env.example) continue ;; esac
  if git show ":$file" | grep -nE "$regex" >/dev/null 2>&1; then
    echo "pre-commit: possible credential in staged file: $file" >&2
    git show ":$file" | grep -nE "$regex" | sed -E 's/(sk-|hf_|AKIA|ghp_)[A-Za-z0-9_-]{4}[A-Za-z0-9_-]*/\1****/g; s/(:[^@\/]{3})[^@\/]*@/\1****@/g' | cut -c1-140 >&2
    found=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ $found -eq 1 ]]; then
  echo "pre-commit: commit refused. Remove the secret (or use --no-verify for a confirmed false positive)." >&2
  exit 1
fi
exit 0
